<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingRight="8dp"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/vocabularySearchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Type Balochi or English word..."
            android:paddingLeft="12dp"
            android:background="@null"
            android:inputType="text"
            android:textSize="16sp"
            android:textColor="#000000"
            android:importantForAutofill="no"/>

        <TextView
            android:id="@+id/clearSearchButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="CLEAR"
            android:textColor="#999999"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/infoAppButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="INFO"
            android:padding="8dp"
            android:textColor="#0066CC"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dictionaryContentDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome to Global Baluchi Dictionary. Definitions will display right here."
                android:textColor="#333333"
                android:textSize="18sp"
                android:lineSpacingMultiplier="1.3"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
